{
  "directory": [
    "./packages/types/src",
    "./packages/utils/src",
    "./packages/scrapers/src",
    "./eslint-plugins"
  ],
  "exclude": [
    "__tests__",
    "__mocks__",
    "packages/.*/index\\.ts$",
    "apps/.*/index\\.ts$",
    ".*\\.test\\.ts$",
    ".*\\.spec\\.ts$",
    ".*\\.test\\.tsx$",
    ".*\\.spec\\.tsx$",
    ".*\\.css\\.ts$",
    ".*\\.css$",
    ".*\\.tsx$"
  ],
  "delete": true,
  "location": "all",
  "structure": "flat",
  "exportDefault": true,
  "removeComments": false,
  "noHeader": false,
  "singleQuotes": false
}
