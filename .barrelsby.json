{
  "directory": [
    "./packages/types/src",
    "./packages/utils/src",
    "./apps/web/src/pwa",
    "./apps/web/src/db",
    "./apps/web/src/performance"
  ],
  "exclude": [
    "__tests__",
    "__mocks__",
    "index\\.ts$",
    "index\\.tsx$",
