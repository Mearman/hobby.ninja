{
  "directory": [
    "./packages/types/src",
    "./packages/utils/src",
    "./apps/web/src/components",
    "./apps/web/src/db",
    "./apps/web/src/pages",
    "./apps/web/src/providers",
    "./apps/web/src/styles",
    "./apps/web/src/utils"
  ],
  "exclude": [
    "__tests__",
    "__mocks__",
    "index\\.ts$",
    "index\\.tsx$",
    ".*\\.test\\.ts$",
    ".*\\.spec\\.ts$",
    ".*\\.test\\.tsx$",
    ".*\\.spec\\.tsx$",
    ".*\\.css\\.ts$",
    ".*\\.css$",
    ".*\\.tsx$"
  ],
  "delete": true,
  "location": "all",
  "structure": "filesystem",
  "exportDefault": false,
  "removeComments": false,
  "noHeader": false,
  "singleQuotes": false
}
