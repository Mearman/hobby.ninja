{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2023", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@hobby-ninja/web": ["apps/web/src/main.tsx"],
      "@hobby-ninja/web/*": ["apps/web/src/*"],
      "@hobby-ninja/types/catalog": ["packages/types/src/catalogData.ts"],
      "@hobby-ninja/types/database": ["packages/types/src/database.ts"],
      "@hobby-ninja/types/language": ["packages/types/src/languageDetection.ts"],
      "@hobby-ninja/types/manual": ["packages/types/src/manualData.ts"],
      "@hobby-ninja/types/product": ["packages/types/src/productData.ts"],
      "@hobby-ninja/types/profile": ["packages/types/src/profileManagement.ts"],
      "@hobby-ninja/types/schemas": ["packages/types/src/schemas.ts"],
      "@hobby-ninja/types/unified": ["packages/types/src/unifiedData.ts"],
      "@hobby-ninja/utils/cache": ["packages/utils/src/cache-manager.ts"],
      "@hobby-ninja/utils/exec": ["packages/utils/src/execFileNoThrow.ts"],
      "@hobby-ninja/utils/language": ["packages/utils/src/languageDetection.ts"],
      "@hobby-ninja/utils/profile": ["packages/utils/src/profileManager.ts"],
      "@hobby-ninja/utils/rendering": ["packages/utils/src/renderingDetection.ts"],
      "@hobby-ninja/cli/*": ["packages/cli/src/*"],
      "@hobby-ninja/scrapers": ["packages/scrapers/src/registry.ts"],
      "@hobby-ninja/scrapers/*": ["packages/scrapers/src/*"],
      "@hobby-ninja/translation": ["packages/translation/src/mod.ts"],
      "@hobby-ninja/translation/*": ["packages/translation/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}