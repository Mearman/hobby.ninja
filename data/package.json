{
	"name": "@hobby-ninja/data",
	"version": "0.0.1",
	"description": "Canonical data source for hobby.ninja",
	"type": "module",
	"main": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		},
		"./items": {
			"types": "./dist/lib/items.d.ts",
			"import": "./dist/lib/items.js"
		},
		"./brands": {
			"types": "./dist/lib/brands.d.ts",
			"import": "./dist/lib/brands.js"
		},
		"./series": {
			"types": "./dist/lib/series.d.ts",
			"import": "./dist/lib/series.js"
		},
		"./categories": {
			"types": "./dist/lib/categories.d.ts",
			"import": "./dist/lib/categories.js"
		},
		"./manuals": {
			"types": "./dist/lib/manuals.d.ts",
			"import": "./dist/lib/manuals.js"
		},
		"./grades": {
			"types": "./dist/lib/grades.d.ts",
			"import": "./dist/lib/grades.js"
		},
		"./scales": {
			"types": "./dist/lib/scales.d.ts",
			"import": "./dist/lib/scales.js"
		},
		"./tags": {
			"types": "./dist/lib/tags.d.ts",
			"import": "./dist/lib/tags.js"
		},
		"./homepage": {
			"types": "./dist/lib/homepage.d.ts",
			"import": "./dist/lib/homepage.js"
		},
		"./search": {
			"types": "./dist/lib/search.d.ts",
			"import": "./dist/lib/search.js"
		},
		"./schemas": {
			"types": "./dist/lib/schemas.d.ts",
			"import": "./dist/lib/schemas.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsx scripts/build.ts && tsup",
		"validate": "tsx scripts/validate.ts",
		"migrate": "tsx scripts/migrate.ts"
	},
	"dependencies": {
		"fuse.js": "^7.1.0",
		"zod": "4.3.4"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"tsx": "^4.21.0"
	}
}
