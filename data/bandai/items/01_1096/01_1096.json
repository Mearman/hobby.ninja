  "description": [
    {
      "ja": "Figure-riseBustに初音ミク登場！！",
      "en": "Hatsune Miku appears in Figure-riseBust! !"
    },
    {
      "ja": "Figure-riseBustの技術をつぎ込んだ決定版！",
      "en": "The definitive edition that incorporates Figure-riseBust technology!"
    },
    {
      "ja": "• ハイクオリティな瞳",
      "en": "• High quality eyes"
    },
    {
      "ja": "レイヤードインジェクションによる瞳、眉、口の色分けを成形色のみで再現！瞳はグリーンのクリアパーツを採用し、黒目の奥行きを表現！",
      "en": "Color-coded eyes, eyebrows, and mouth created by layered injection are reproduced using molded colors only! The eyes use green clear parts to express the depth of the black eyes!"
    },
    {
      "ja": "• レイヤードインジェクションの進化！",
      "en": "• Evolution of layered injection!"
    },
    {
      "ja": "表情パーツは1つのパーツで再現！レイヤードインジェクションの最先端技術を採用！",
      "en": "Facial expression parts are reproduced with one part! Adopts cutting-edge layered injection technology!"
    },
    {
      "ja": "• こだわりの造作",
      "en": "• Special features"
    },
    {
      "ja": "原型師こだわりの造形。顔、髪に加え指先や背中など初音ミクの魅力を最大限に追求！",
      "en": "Sculpted by a master sculptor. In addition to her face and hair, we pursue Hatsune Miku's charm to the fullest, including her fingertips and back!"
    },
    {
      "ja": "• 繊細な質感",
      "en": "• Delicate texture"
    },
    {
      "ja": "パーツごとに艶やマットの成形品を使い分け、髪、衣装の質感を余すことなく再現！",
      "en": "Glossy and matte molded parts are used for each part to perfectly reproduce the texture of the hair and costume!"
    }
  ],
