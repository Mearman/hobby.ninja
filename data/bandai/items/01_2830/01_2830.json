      "ja": "• <例1>1/60スケール(大型)用1個",
      "en": "• <Example 1> 1 piece for 1/60 Scale (large size)"
    },
    {
      "ja": "• <例2>1/60スケール用1個、1/144スケール(小・中型)用2個",
      "en": "• <Example 2> 1 piece for 1/60 Scale, 2 pieces for 1/144 Scale (small/medium size)"
    },
    {
      "ja": "• <例3>1/100スケール用1個、1/144スケール(小・中型)用1個",
      "en": "• <Example 3> 1 piece for 1/100 Scale, 1 piece for 1/144 Scale (small/medium size)"
