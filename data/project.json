{
	"name": "data",
	"$schema": "../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "data/src",
	"projectType": "library",
	"tags": ["scope:data"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "data",
				"command": "pnpm tsx scripts/build.ts"
			},
			"outputs": ["{projectRoot}/dist"],
			"inputs": [
				"{projectRoot}/src/**/*",
				"{projectRoot}/scripts/build.ts"
			],
			"cache": true
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "data",
				"command": "tsc --noEmit"
			}
		},
		"validate": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "data",
				"command": "pnpm tsx scripts/validate.ts"
			}
		}
	}
}
