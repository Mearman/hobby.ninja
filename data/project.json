{
	"name": "data",
	"$schema": "../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "data/src",
	"projectType": "library",
	"tags": ["scope:data"],
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "data",
				"commands": ["pnpm tsx scripts/build.ts", "tsup"],
				"parallel": false,
				"env": {
					"NODE_OPTIONS": "--max-old-space-size=8192"
				}
			},
			"outputs": ["{projectRoot}/dist"],
			"inputs": [
				"{projectRoot}/src/**/*",
				"{projectRoot}/lib/**/*",
				"{projectRoot}/scripts/build.ts",
				"{projectRoot}/tsup.config.ts"
			],
			"cache": true,
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "data",
				"command": "tsc --noEmit"
			},
			"dependsOn": ["build"]
		},
		"validate": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "data",
				"command": "pnpm tsx scripts/validate.ts"
			}
		},
		"watch:build": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "data",
				"commands": ["pnpm tsx scripts/build.ts", "tsup"],
				"parallel": false,
				"env": {
					"NODE_OPTIONS": "--max-old-space-size=8192"
				}
			},
			"outputs": ["{projectRoot}/dist"],
			"inputs": [
				"{projectRoot}/src/**/*",
				"{projectRoot}/lib/**/*",
				"{projectRoot}/scripts/build.ts",
				"{projectRoot}/tsup.config.ts"
			],
			"cache": false
		}
	}
}
