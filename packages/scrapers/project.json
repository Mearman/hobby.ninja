{
  "name": "scrapers",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/scrapers/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{workspaceRoot}/packages/scrapers/dist"],
      "options": {
        "outputPath": "packages/scrapers/dist",
        "configFile": "packages/scrapers/vite.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/scrapers/**/*.ts"]
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/scrapers/**/*.ts"],
        "fix": true
      }
    },
    "check": {
      "dependsOn": ["typecheck", "lint", "build"],
      "cache": true
    }
  }
}