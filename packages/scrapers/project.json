{
  "name": "scrapers",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/scrapers/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/scrapers",
        "main": "packages/scrapers/src/index.ts",
        "tsConfig": "packages/scrapers/tsconfig.json",
        "assets": []
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "options": {
        "tsConfig": "packages/scrapers/tsconfig.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/scrapers/**/*.ts"]
      }
    },
    "lint:fix": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/scrapers/**/*.ts"],
        "fix": true
      }
    }
  }
}