{
  "name": "@unnamed-gunpla-app/scrapers",
  "version": "1.0.0",
  "description": "Web scrapers for Gundam and Gunpla data sources",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist",
    "download-manuals": "node dist/manual-downloader/cli/index.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "parse5": "^7.1.2",
    "zod": "^3.22.0",
    "p-limit": "^4.0.0",
    "@unnamed-gunpla-app/types": "workspace:*",
    "@unnamed-gunpla-app/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}