{
  "name": "@hobby-ninja/scrapers",
  "version": "1.0.0",
  "description": "Web scrapers for Gundam and Gunpla data sources",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist",
    "download-manuals": "node dist/manual-downloader/cli/index.js"
  },
  "dependencies": {
    "cheerio": "*",
    "parse5": "^7.1.2",
    "zod": "*",
    "p-limit": "^4.0.0",
    "@hobby-ninja/types": "workspace:*",
    "@hobby-ninja/utils": "workspace:*",
    "@hobby-ninja/translation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "*",
    "tsup": "^8.0.0",
    "typescript": "*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}