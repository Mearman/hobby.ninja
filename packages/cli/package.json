{
  "name": "@unnamed-gunpla-app/cli",
  "version": "0.0.1",
  "description": "CLI tool for scraping Gundam/Gunpla data from various sources",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gundam-scraper": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node ./dist/bin/cli.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist .cache",
    "scrape": "node ./dist/bin/cli.js scrape",
    "scrape:bandai": "node ./dist/bin/cli.js scrape --scrapers bandai",
    "scrape:gundam-info": "node ./dist/bin/cli.js scrape --scrapers gundam-info",
    "scrape:dalong": "node ./dist/bin/cli.js scrape --scrapers dalong",
    "clear-cache": "node ./dist/bin/cli.js cache clear",
    "status": "node ./dist/bin/cli.js status --cache-stats"
  },
  "keywords": [
    "gundam",
    "gunpla",
    "scraping",
    "cli",
    "data",
    "bandai"
  ],
  "author": "Gunpla App Team",
  "license": "MIT",
  "dependencies": {
    "@unnamed-gunpla-app/utils": "workspace:*",
    "@unnamed-gunpla-app/types": "workspace:*",
    "@workspace/scrapers": "workspace:*",
    "cheerio": "latest",
    "commander": "latest",
    "playwright": "latest",
    "zod": "latest",
    "inquirer": "latest"
  },
  "devDependencies": {
    "@types/cheerio": "latest",
    "@types/inquirer": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "rimraf": "latest"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": ["{options.outputPath}"],
        "options": {
          "outputPath": "dist/packages/cli",
          "main": "packages/cli/src/index.ts",
          "tsConfig": "packages/cli/tsconfig.json",
          "assets": []
        }
      },
      "test": {
        "executor": "@nx/vite:test",
        "outputs": ["{workspaceRoot}/coverage/packages/cli"],
        "options": {
          "passWithNoTests": true
        }
      },
      "lint": {
        "executor": "@nx/eslint:lint",
        "outputs": ["{options.outputFile}"]
      }
    }
  }
}