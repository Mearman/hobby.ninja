{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"noEmit": false,
		"composite": true,
		"incremental": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/*.test.ts", "**/*.spec.ts"]
}