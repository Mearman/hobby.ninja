{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"outDir": "dist",
		"rootDir": ".",
		"noEmit": false,
		"composite": true,
		"incremental": true,
		"types": ["node"],
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/*.test.ts", "**/*.spec.ts", "src/examples.ts"],
	"references": []
}
