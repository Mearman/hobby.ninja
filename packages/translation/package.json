{
	"name": "@hobby-ninja/translation",
	"description": "Translation utilities for Gunpla data with caching and error handling",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "eslint src --ext .ts,.tsx",
		"test": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"proper-lockfile": "4.1.2",
		"zod": "4.1.13"
	},
	"devDependencies": {
		"@nx/eslint": "22.2.0",
		"@nx/js": "22.2.0",
		"@nx/vite": "22.2.0",
		"@types/proper-lockfile": "4.1.4",
		"@vitest/coverage-v8": "4.0.15",
		"@vitest/ui": "4.0.15",
		"eslint": "9.39.1",
		"jsdom": "27.3.0",
		"typescript": "5.9.3",
		"vitest": "4.0.15"
	},
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"import": "./dist/mod.js"
		}
	},
	"main": "./dist/mod.js",
	"nx": {
		"targets": {
			"build": {
				"executor": "@nx/js:tsc",
				"outputs": [
					"{options.outputPath}"
				],
				"options": {
					"outputPath": "dist/packages/translation",
					"main": "packages/translation/src/mod.ts",
					"tsConfig": "packages/translation/tsconfig.json",
					"assets": []
				}
			},
			"test": {
				"executor": "@nx/vitest:test",
				"outputs": [
					"{workspaceRoot}/coverage/packages/translation"
				],
				"options": {
					"config": "packages/translation/vite.config.ts"
				}
			},
			"lint": {
				"executor": "@nx/eslint:lint"
			}
		}
	},
	"publishConfig": {
		"access": "restricted"
	},
	"types": "./dist/mod.d.ts"
}
