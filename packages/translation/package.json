{
	"name": "@hobby-ninja/translation",
	"version": "0.0.1",
	"type": "module",
	"description": "Translation utilities for Gunpla data with caching and error handling",
	"main": "./dist/mod.js",
	"types": "./dist/mod.d.ts",
	"exports": {
		".": {
			"import": "./dist/mod.js",
			"types": "./dist/mod.d.ts"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"lint": "eslint src --ext .ts,.tsx"
	},
	"dependencies": {
		"proper-lockfile": "^4.1.2",
		"zod": "4.2.0-canary.20251202T062120"
	},
	"devDependencies": {
		"@nx/eslint": "22.1.3",
		"@nx/js": "22.1.3",
		"@nx/vite": "22.1.3",
		"@types/proper-lockfile": "^4.1.4",
		"@vitest/coverage-v8": "4.0.15",
		"@vitest/ui": "4.0.15",
		"eslint": "*",
		"jsdom": "^27.2.0",
		"typescript": "*",
		"vitest": "*"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"nx": {
		"targets": {
			"build": {
				"executor": "@nx/js:tsc",
				"outputs": [
					"{options.outputPath}"
				],
				"options": {
					"outputPath": "dist/packages/translation",
					"main": "packages/translation/src/mod.ts",
					"tsConfig": "packages/translation/tsconfig.json",
					"assets": []
				}
			},
			"test": {
				"executor": "@nx/vitest:test",
				"outputs": [
					"{workspaceRoot}/coverage/packages/translation"
				],
				"options": {
					"config": "packages/translation/vite.config.ts"
				}
			},
			"lint": {
				"executor": "@nx/eslint:lint"
			}
		}
	}
}