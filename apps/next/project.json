{
  "name": "next",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/next/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/next"
      },
      "dependsOn": ["typecheck", "build-data"],
      "configurations": {
        "development": {
          "outputPath": "dist/apps/next"
        },
        "production": {
          "outputPath": "dist/apps/next"
        }
      }
    },
    "build:dev": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/next",
        "env": {
          "NODE_ENV": "development"
        }
      }
    },
    "serve": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "port": 3001,
        "hostname": "localhost"
      },
      "dependsOn": ["build:dev"],
      "configurations": {
        "development": {
          "buildTarget": "next:build:dev",
          "dev": true,
          "watch": true
        },
        "production": {
          "buildTarget": "next:build:production",
          "dev": false
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/next/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverageReporters": ["text"]
        }
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/next/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/next"
      }
    },
    "build-data": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/data"],
      "options": {
        "command": "npx tsx scripts/build-data-cli.ts",
        "cwd": "{projectRoot}",
        "cache": true
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/data/api/graph/**/*"
      ],
      "configurations": {
        "development": {
          "command": "npx tsx scripts/build-data-cli.ts --output-dir src/data"
        },
        "production": {
          "command": "npx tsx scripts/build-data-cli.ts --output-dir src/data"
        },
        "custom": {
          "command": "npx tsx scripts/build-data-cli.ts {args}"
        }
      }
    }
  },
  "tags": []
}