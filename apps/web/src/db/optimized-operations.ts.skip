import Dexie, { Table } from 'dexie';
import { UserSettings, CollectionEntry, WishlistEntry, BuildLog } from '@unnamed-gunpla-app/types';
import { gunplaDB } from './index';

// Enhanced database interface with optimized indexes
export interface OptimizedGunplaAppDatabase {
  userSettings: Table<UserSettings, string>;
  collectionEntries: Table<CollectionEntry, string>;
  wishlistEntries: Table<WishlistEntry, string>;
  buildLogs: Table<BuildLog, string>;
}

// Type definitions for filtering and pagination
export interface PaginationOptions {
  page: number;
  limit: number;
  offset?: number;
}

export interface CollectionFilters {
  status?: string;
  grade?: string;
  scale?: string;
  priceMin?: number;
  priceMax?: number;
  addedAfter?: string;
  addedBefore?: string;
  search?: string;
}

export interface SortOptions {
  field: keyof CollectionEntry | 'addedAt' | 'updatedAt' | 'title' | 'price';
  direction: 'asc' | 'desc';
}

export interface PaginatedResult<T> {
  data: T[];
  total: number;
  page: number;
  limit: number;
  hasNext: boolean;
  hasPrev: boolean;
}

// Performance-optimized cache manager
class DatabaseCacheManager {
  private cache = new Map<string, {
    data: any;
    timestamp: number;
    ttl: number;
    promise?: Promise<any>;
  }>();

  async getCachedData<T>(
    key: string,
    fetchFn: () => Promise<T>,
    ttl = 300000 // 5 minutes default TTL
  ): Promise<T> {
    const cached = this.cache.get(key);

    if (cached && Date.now() - cached.timestamp < cached.ttl) {
      return cached.data;
    }

    // If there's an ongoing request, return it
    if (cached?.promise) {
      return cached.promise;
    }

    // Create new promise for the request
    const promise = fetchFn();
    this.cache.set(key, {
      data: null as any,
      timestamp: Date.now(),
      ttl,
      promise
    });

    try {
      const data = await promise;
      this.cache.set(key, {
        data,
        timestamp: Date.now(),
        ttl,
        promise: undefined
      });
      return data;
    } catch (error) {
      this.cache.delete(key);
      throw error;
    }
  }

  invalidateCache(key?: string): void {
    if (key) {
      this.cache.delete(key);
    } else {
      this.cache.clear();
    }
  }

  getCacheSize(): number {
    return this.cache.size;
  }
}

// Global cache manager instance
export const cacheManager = new DatabaseCacheManager();

// Optimized database operations with pagination and caching
export const optimizedDbOperations = {
  // Enhanced collection operations with pagination and filtering
  async getPaginatedCollectionEntries(
    pagination: PaginationOptions,
    filters?: CollectionFilters,
    sort?: SortOptions
  ): Promise<PaginatedResult<CollectionEntry>> {
    const cacheKey = `collection_${JSON.stringify({ pagination, filters, sort })}`;

    return cacheManager.getCachedData(cacheKey, async () => {
      let query = gunplaDB.collectionEntries.toCollection();

      // Apply filters
      if (filters) {
        query = query.filter(entry => this.matchesCollectionFilters(entry, filters));
      }

      // Apply sorting
      if (sort) {
        if (sort.field === 'addedAt' || sort.field === 'updatedAt') {
          query = query.orderBy(sort.field);
        } else {
          query = query.orderBy('title'); // Default sort, then filter for complex sorts
        }
      } else {
        query = query.orderBy('addedAt');
      }

      // Get total count before pagination
      const total = await query.count();

      // Apply pagination
      const { page, limit } = pagination;
      const offset = pagination.offset || (page - 1) * limit;

      const data = await query
        .offset(offset)
        .limit(limit)
        .toArray();

      // Apply client-side sorting for complex fields if needed
      if (sort && sort.field !== 'addedAt' && sort.field !== 'updatedAt') {
        data.sort((a, b) => {
          const aValue = a[sort.field as keyof CollectionEntry];
          const bValue = b[sort.field as keyof CollectionEntry];

          if (aValue === undefined && bValue === undefined) return 0;
          if (aValue === undefined) return 1;
          if (bValue === undefined) return -1;

          const comparison = aValue < bValue ? -1 : aValue > bValue ? 1 : 0;
          return sort.direction === 'desc' ? -comparison : comparison;
        });
      }

      return {
        data,
        total,
        page,
        limit,
        hasNext: offset + limit < total,
        hasPrev: page > 1,
      };
    });
  },

  // Optimized bulk operations
  async bulkAddCollectionEntries(entries: Omit<CollectionEntry, 'id' | 'addedAt' | 'updatedAt'>[]): Promise<string[]> {
    const timestamp = new Date().toISOString();
    const newEntries: CollectionEntry[] = entries.map(entry => ({
      ...entry,
      id: crypto.randomUUID(),
      addedAt: timestamp,
      updatedAt: timestamp,
    }));

    await gunplaDB.collectionEntries.bulkAdd(newEntries);
    cacheManager.invalidateCache('collection_');

    return newEntries.map(entry => entry.id);
  },

  async bulkUpdateCollectionEntries(updates: { id: string; data: Partial<CollectionEntry> }[]): Promise<void> {
    const timestamp = new Date().toISOString();
    const updatePromises = updates.map(({ id, data }) =>
      gunplaDB.collectionEntries.update(id, {
        ...data,
        updatedAt: timestamp,
      })
    );

    await Promise.all(updatePromises);
    cacheManager.invalidateCache('collection_');
  },

  async bulkDeleteCollectionEntries(ids: string[]): Promise<void> {
    await gunplaDB.collectionEntries.bulkDelete(ids);
    cacheManager.invalidateCache('collection_');
  },

  // Optimized search functionality
  async searchCollectionEntries(searchTerm: string, limit = 20): Promise<CollectionEntry[]> {
    const cacheKey = `search_${searchTerm}_${limit}`;

    return cacheManager.getCachedData(cacheKey, async () => {
      const term = searchTerm.toLowerCase();

      return await gunplaDB.collectionEntries
        .filter(entry =>
          entry.title.toLowerCase().includes(term) ||
          entry.sku.toLowerCase().includes(term) ||
          entry.series.toLowerCase().includes(term)
        )
        .limit(limit)
        .toArray();
    }, 60000); // Shorter TTL for search results
  },

  // Statistics and analytics
  async getCollectionStatistics(): Promise<{
    totalItems: number;
    totalValue: number;
    itemsByGrade: Record<string, number>;
    itemsByScale: Record<string, number>;
    recentAdditions: CollectionEntry[];
  }> {
    const cacheKey = 'collection_stats';

    return cacheManager.getCachedData(cacheKey, async () => {
      const allEntries = await gunplaDB.collectionEntries.toArray();

      const totalItems = allEntries.length;
      const totalValue = allEntries.reduce((sum, entry) => sum + (entry.price || 0), 0);

      const itemsByGrade: Record<string, number> = {};
      const itemsByScale: Record<string, number> = {};

      allEntries.forEach(entry => {
        itemsByGrade[entry.grade] = (itemsByGrade[entry.grade] || 0) + 1;
        itemsByScale[entry.scale] = (itemsByScale[entry.scale] || 0) + 1;
      });

      const recentAdditions = allEntries
        .sort((a, b) => new Date(b.addedAt).getTime() - new Date(a.addedAt).getTime())
        .slice(0, 5);

      return {
        totalItems,
        totalValue,
        itemsByGrade,
        itemsByScale,
        recentAdditions,
      };
    }, 300000); // 5 minutes TTL for stats
  },

  // Helper function to match filters
  private matchesCollectionFilters(entry: CollectionEntry, filters: CollectionFilters): boolean {
    if (filters.status && entry.status !== filters.status) return false;
    if (filters.grade && entry.grade !== filters.grade) return false;
    if (filters.scale && entry.scale !== filters.scale) return false;

    if (filters.priceMin !== undefined && (!entry.price || entry.price < filters.priceMin)) return false;
    if (filters.priceMax !== undefined && (!entry.price || entry.price > filters.priceMax)) return false;

    if (filters.addedAfter && new Date(entry.addedAt) < new Date(filters.addedAfter)) return false;
    if (filters.addedBefore && new Date(entry.addedAt) > new Date(filters.addedBefore)) return false;

    if (filters.search) {
      const searchLower = filters.search.toLowerCase();
      const searchableText = `${entry.title} ${entry.sku} ${entry.series}`.toLowerCase();
      if (!searchableText.includes(searchLower)) return false;
    }

    return true;
  },

  // Similar optimized operations for wishlist
  async getPaginatedWishlistEntries(
    pagination: PaginationOptions,
    filters?: Partial<CollectionFilters>
  ): Promise<PaginatedResult<WishlistEntry>> {
    const cacheKey = `wishlist_${JSON.stringify({ pagination, filters })}`;

    return cacheManager.getCachedData(cacheKey, async () => {
      let query = gunplaDB.wishlistEntries.toCollection();

      if (filters) {
        query = query.filter(entry => this.matchesWishlistFilters(entry, filters));
      }

      query = query.orderBy('addedAt').reverse();

      const { page, limit } = pagination;
      const offset = pagination.offset || (page - 1) * limit;

      const total = await query.count();
      const data = await query.offset(offset).limit(limit).toArray();

      return {
        data,
        total,
        page,
        limit,
        hasNext: offset + limit < total,
        hasPrev: page > 1,
      };
    });
  },

  private matchesWishlistFilters(entry: WishlistEntry, filters: Partial<CollectionFilters>): boolean {
    if (filters.grade && entry.grade !== filters.grade) return false;
    if (filters.scale && entry.scale !== filters.scale) return false;
    if (filters.priority && entry.priority !== filters.priority) return false;

    if (filters.search) {
      const searchLower = filters.search.toLowerCase();
      const searchableText = `${entry.title} ${entry.sku} ${entry.series}`.toLowerCase();
      if (!searchableText.includes(searchLower)) return false;
    }

    return true;
  },

  // Cache management
  invalidateAllCaches(): void {
    cacheManager.invalidateCache();
  },

  getCacheInfo(): {
    size: number;
    keys: string[];
  } {
    return {
      size: cacheManager.getCacheSize(),
      keys: Array.from((cacheManager as any).cache.keys()),
    };
  },
};

// Transaction helper for complex operations
export class DatabaseTransaction {
  private static async executeTransaction<T>(
    mode: Dexie.TransactionMode,
    tables: Table<any, any>[],
    operation: () => Promise<T>
  ): Promise<T> {
    return await gunplaDB.transaction(mode, ...tables, operation);
  }

  // Complex transaction: Move item from wishlist to collection
  static async moveFromWishlistToCollection(
    wishlistId: string,
    collectionData: Omit<CollectionEntry, 'id' | 'addedAt' | 'updatedAt'>
  ): Promise<string> {
    return this.executeTransaction(
      'rw',
      [gunplaDB.wishlistEntries, gunplaDB.collectionEntries],
      async () => {
        // Remove from wishlist
        await gunplaDB.wishlistEntries.delete(wishlistId);

        // Add to collection
        const collectionId = await optimizedDbOperations.bulkAddCollectionEntries([collectionData]);

        // Invalidate caches
        cacheManager.invalidateCache();

        return collectionId[0];
      }
    );
  }

  // Bulk export with progress tracking
  static async exportAllDataWithProgress(
    onProgress?: (progress: number, stage: string) => void
  ): Promise<{
    userSettings: UserSettings | null;
    collectionEntries: CollectionEntry[];
    wishlistEntries: WishlistEntry[];
    buildLogs: BuildLog[];
  }> {
    return this.executeTransaction(
      'r',
      [gunplaDB.userSettings, gunplaDB.collectionEntries, gunplaDB.wishlistEntries, gunplaDB.buildLogs],
      async () => {
        onProgress?.(10, 'Exporting user settings...');
        const userSettings = await gunplaDB.userSettings.get('default') || null;

        onProgress?.(30, 'Exporting collection entries...');
        const collectionEntries = await gunplaDB.collectionEntries.toArray();

        onProgress?.(60, 'Exporting wishlist entries...');
        const wishlistEntries = await gunplaDB.wishlistEntries.toArray();

        onProgress?.(80, 'Exporting build logs...');
        const buildLogs = await gunplaDB.buildLogs.toArray();

        onProgress?.(100, 'Export complete');

        return {
          userSettings,
          collectionEntries,
          wishlistEntries,
          buildLogs,
        };
      }
    );
  }
}

export default optimizedDbOperations;