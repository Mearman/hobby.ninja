/**
 * Production-Ready Service Worker
 *
 * A comprehensive service worker implementation with:
 * - Multiple caching strategies (CacheFirst, NetworkFirst, StaleWhileRevalidate)
 * - Offline functionality and fallbacks
 * - Background sync support
 * - Push notifications
 * - Request deduplication
 * - Cache cleanup and management
 * - Performance monitoring
 * - Error handling and recovery
 */

import type { PWAConfig, CacheStrategy, ExtendableEvent, FetchEvent, PushEvent, NotificationEvent, SyncEvent } from './types/pwa';
import { getPWAConfig, getCacheConfigForUrl } from './config/pwaConfig';
import { logger } from './logging/logger';
import { CacheManager } from './cache/cacheManager';
import { NotificationManager } from './notifications/notificationManager';
import { SyncManager } from './sync/syncManager';
import { MetricsCollector } from './utils/metricsCollector';

/**
 * Service Worker Class
 *
 * Encapsulates all service worker functionality with proper error handling
 * and performance monitoring.
 */
class ServiceWorker {
  private config: PWAConfig;
  private cacheManager: CacheManager;
  private notificationManager: NotificationManager;
  private syncManager: SyncManager;
  private metricsCollector: MetricsCollector;
  private pendingRequests = new Map<string, Promise<Response>>();

  constructor() {
    this.config = getPWAConfig();
    this.cacheManager = new CacheManager(this.config);
    this.notificationManager = new NotificationManager(this.config);
    this.syncManager = new SyncManager(this.config);
    this.metricsCollector = new MetricsCollector();

    this.initialize();
  }

  /**
   * Initialize the service worker
   */
  private initialize(): void {
    logger.info('Service Worker initializing', {
      version: this.config.version,
      features: {
        offline: this.config.offline.enabled,
        push: this.config.push.enabled,
        sync: this.config.sync.enabled,
      }
    });

    // Set up event listeners
    this.setupEventListeners();
  }

  /**
   * Set up service worker event listeners
   */
  private setupEventListeners(): void {
    // Use global self in service worker context
    const sw = self as ServiceWorker;

    sw.addEventListener('install', this.handleInstall.bind(this) as EventListener);
    sw.addEventListener('activate', this.handleActivate.bind(this) as EventListener);
    sw.addEventListener('fetch', this.handleFetch.bind(this) as EventListener);
    sw.addEventListener('message', this.handleMessage.bind(this) as EventListener);

    if (this.config.push.enabled) {
      sw.addEventListener('push', this.handlePush.bind(this) as EventListener);
      sw.addEventListener('notificationclick', this.handleNotificationClick.bind(this) as EventListener);
      sw.addEventListener('notificationclose', this.handleNotificationClose.bind(this) as EventListener);
    }

    if (this.config.sync.enabled) {
      sw.addEventListener('sync', this.handleSync.bind(this) as EventListener);
    }

    // Performance and error monitoring
    sw.addEventListener('online', this.handleOnline.bind(this) as EventListener);
    sw.addEventListener('offline', this.handleOffline.bind(this) as EventListener);
    sw.addEventListener('error', this.handleError.bind(this) as EventListener);
    sw.addEventListener('unhandledrejection', this.handleUnhandledRejection.bind(this) as EventListener);
  }

  /**
   * Handle service worker installation
   */
  private async handleInstall(event: ExtendableEvent): Promise<void> {
    logger.info('Service Worker installing');

    event.waitUntil(
      (async () => {
        try {
          // Pre-cache critical assets
          await this.cacheManager.precacheAssets();

          // Clean up old caches
          await this.cacheManager.cleanupOldCaches();

          logger.info('Service Worker installation completed');

          // Force activation for better user experience
          await self.skipWaiting();
        } catch (error) {
          logger.error('Service Worker installation failed', { error });
          throw error;
        }
      })()
    );
  }

  /**
   * Handle service worker activation
   */
  private async handleActivate(event: ExtendableEvent): Promise<void> {
    logger.info('Service Worker activating');

    event.waitUntil(
      (async () => {
        try {
          // Claim all clients to take control immediately
          await self.clients.claim();

          // Clean up old caches
          await this.cacheManager.cleanupOldCaches();

          // Initialize background sync if enabled
          if (this.config.sync.enabled) {
            await this.syncManager.initialize();
          }

          logger.info('Service Worker activation completed');

          // Notify all clients about the update
          await this.notifyClientsUpdate();
        } catch (error) {
          logger.error('Service Worker activation failed', { error });
          throw error;
        }
      })()
    );
  }

  /**
   * Handle fetch events with smart caching strategies
   */
  private async handleFetch(event: FetchEvent): Promise<void> {
    const { request } = event;
    const startTime = performance.now();

    try {
      // Skip non-GET requests and chrome-extension requests
      if (request.method !== 'GET' || request.url.startsWith('chrome-extension://')) {
        return;
      }

      // Check for network-only routes
      if (this.config.offline.networkOnlyRoutes.some(route =>
        new URL(request.url).pathname.startsWith(route)
      )) {
        event.respondWith(fetch(request));
        return;
      }

      // Implement request deduplication
      const cacheKey = this.generateCacheKey(request);
      if (this.pendingRequests.has(cacheKey)) {
        event.respondWith(this.pendingRequests.get(cacheKey)!);
        return;
      }

      const responsePromise = this.handleRequest(request);
      this.pendingRequests.set(cacheKey, responsePromise);

      // Clean up pending requests after completion
      responsePromise.finally(() => {
        this.pendingRequests.delete(cacheKey);

        // Record metrics
        const duration = performance.now() - startTime;
        this.metricsCollector.recordRequest(request, duration);
      });

      event.respondWith(responsePromise);
    } catch (error) {
      logger.error('Fetch handler error', {
        url: request.url,
        method: request.method,
        error
      });

      // Fallback to network if caching fails
      event.respondWith(fetch(request));
    }
  }

  /**
   * Handle individual requests with appropriate caching strategy
   */
  private async handleRequest(request: Request): Promise<Response> {
    const cacheConfig = getCacheConfigForUrl(request.url);

    if (!cacheConfig) {
      // No caching strategy - fetch directly
      return fetch(request);
    }

    switch (cacheConfig.strategy) {
      case 'cacheFirst':
        return this.handleCacheFirst(request, cacheConfig);

      case 'networkFirst':
        return this.handleNetworkFirst(request, cacheConfig);

      case 'staleWhileRevalidate':
        return this.handleStaleWhileRevalidate(request, cacheConfig);

      case 'networkOnly':
        return fetch(request);

      case 'cacheOnly':
        return this.handleCacheOnly(request, cacheConfig);

      default:
        logger.warn('Unknown cache strategy', { strategy: cacheConfig.strategy });
        return fetch(request);
    }
  }

  /**
   * Cache First Strategy
   * Serve from cache, fallback to network
   */
  private async handleCacheFirst(request: Request, config: any): Promise<Response> {
    try {
      const cachedResponse = await this.cacheManager.get(request, config.name);

      if (cachedResponse && !this.isExpired(cachedResponse, config.maxAge)) {
        logger.debug('Cache hit', { url: request.url, strategy: 'cacheFirst' });
        return cachedResponse;
      }
    } catch (error) {
      logger.warn('Cache retrieval failed', { url: request.url, error });
    }

    try {
      const networkResponse = await this.fetchWithTimeout(request, config.networkTimeout);

      if (networkResponse.ok) {
        // Cache the response
        const responseToCache = networkResponse.clone();
        this.cacheManager.put(request, responseToCache, config.name).catch(error => {
          logger.warn('Cache storage failed', { url: request.url, error });
        });
      }

      logger.debug('Network fetch', { url: request.url, strategy: 'cacheFirst' });
      return networkResponse;
    } catch (error) {
      // Return cached response even if expired
      const cachedResponse = await this.cacheManager.get(request, config.name);
      if (cachedResponse) {
        logger.debug('Cache fallback (expired)', { url: request.url, strategy: 'cacheFirst' });
        return cachedResponse;
      }

      // Serve offline fallback if available
      if (this.config.offline.enabled) {
        return this.serveOfflineFallback(request);
      }

      throw error;
    }
  }

  /**
   * Network First Strategy
   * Try network first, fallback to cache
   */
  private async handleNetworkFirst(request: Request, config: any): Promise<Response> {
    try {
      const networkResponse = await this.fetchWithTimeout(request, config.networkTimeout);

      if (networkResponse.ok) {
        // Cache the fresh response
        const responseToCache = networkResponse.clone();
        this.cacheManager.put(request, responseToCache, config.name).catch(error => {
          logger.warn('Cache storage failed', { url: request.url, error });
        });
      }

      logger.debug('Network fetch', { url: request.url, strategy: 'networkFirst' });
      return networkResponse;
    } catch (error) {
      // Fallback to cache
      const cachedResponse = await this.cacheManager.get(request, config.name);
      if (cachedResponse) {
        logger.debug('Cache fallback', { url: request.url, strategy: 'networkFirst' });
        return cachedResponse;
      }

      // Serve offline fallback if available
      if (this.config.offline.enabled) {
        return this.serveOfflineFallback(request);
      }

      throw error;
    }
  }

  /**
   * Stale While Revalidate Strategy
   * Serve from cache while revalidating in background
   */
  private async handleStaleWhileRevalidate(request: Request, config: any): Promise<Response> {
    const cache = await this.cacheManager.openCache(config.name);
    const cachedResponse = await cache.match(request);

    // Always try to update in background
    const fetchPromise = this.fetchWithTimeout(request, config.networkTimeout)
      .then(networkResponse => {
        if (networkResponse.ok) {
          cache.put(request, networkResponse.clone()).catch(error => {
            logger.warn('Background cache update failed', { url: request.url, error });
          });
        }
        return networkResponse;
      })
      .catch(error => {
        logger.warn('Background fetch failed', { url: request.url, error });
        throw error;
      });

    // Return cached version immediately if available
    if (cachedResponse) {
      logger.debug('Cache hit', { url: request.url, strategy: 'staleWhileRevalidate' });

      // Continue fetch in background without waiting
      fetchPromise.catch(() => {}); // Suppress unhandled rejection

      return cachedResponse;
    }

    // Wait for network if no cache
    logger.debug('Network fetch (no cache)', { url: request.url, strategy: 'staleWhileRevalidate' });
    return fetchPromise;
  }

  /**
   * Cache Only Strategy
   * Serve only from cache
   */
  private async handleCacheOnly(request: Request, config: any): Promise<Response> {
    const cachedResponse = await this.cacheManager.get(request, config.name);

    if (cachedResponse) {
      logger.debug('Cache hit', { url: request.url, strategy: 'cacheOnly' });
      return cachedResponse;
    }

    // Serve offline fallback if available
    if (this.config.offline.enabled) {
      return this.serveOfflineFallback(request);
    }

    throw new Error('No cache entry available');
  }

  /**
   * Handle push events
   */
  private async handlePush(event: PushEvent): Promise<void> {
    logger.info('Push event received');

    event.waitUntil(
      (async () => {
        try {
          await this.notificationManager.handlePush(event);
          this.metricsCollector.recordPushReceived();
        } catch (error) {
          logger.error('Push handling failed', { error });
        }
      })()
    );
  }

  /**
   * Handle notification clicks
   */
  private async handleNotificationClick(event: NotificationEvent): Promise<void> {
    logger.info('Notification clicked', {
      action: event.action,
      notification: event.notification.title
    });

    event.waitUntil(
      (async () => {
        try {
          await this.notificationManager.handleNotificationClick(event);
          this.metricsCollector.recordNotificationClick();
        } catch (error) {
          logger.error('Notification click handling failed', { error });
        }
      })()
    );
  }

  /**
   * Handle notification closes
   */
  private async handleNotificationClose(event: NotificationEvent): Promise<void> {
    logger.info('Notification closed', {
      notification: event.notification.title
    });

    event.waitUntil(
      (async () => {
        try {
          await this.notificationManager.handleNotificationClose(event);
          this.metricsCollector.recordNotificationClose();
        } catch (error) {
          logger.error('Notification close handling failed', { error });
        }
      })()
    );
  }

  /**
   * Handle background sync events
   */
  private async handleSync(event: SyncEvent): Promise<void> {
    logger.info('Sync event received', { tag: event.tag });

    event.waitUntil(
      (async () => {
        try {
          await this.syncManager.handleSync(event);
          this.metricsCollector.recordSyncSuccess(event.tag);
        } catch (error) {
          logger.error('Sync handling failed', { tag: event.tag, error });
          this.metricsCollector.recordSyncFailure(event.tag);
        }
      })()
    );
  }

  /**
   * Handle messages from clients
   */
  private async handleMessage(event: ExtendableEvent): Promise<void> {
    const message = event.data;

    logger.debug('Message received from client', { type: message?.type });

    event.waitUntil(
      (async () => {
        try {
          switch (message?.type) {
            case 'SKIP_WAITING':
              await self.skipWaiting();
              break;

            case 'GET_VERSION':
              await this.sendToClients({
                type: 'VERSION_RESPONSE',
                version: this.config.version
              });
              break;

            case 'CACHE_UPDATE':
              if (message.url) {
                await this.updateCache(message.url);
              }
              break;

            case 'SYNC_REQUEST':
              if (message.tag && this.config.sync.enabled) {
                await this.syncManager.requestSync(message.tag);
              }
              break;

            default:
              logger.warn('Unknown message type', { type: message?.type });
          }
        } catch (error) {
          logger.error('Message handling failed', { error });
        }
      })()
    );
  }

  /**
   * Handle online event
   */
  private handleOnline(): void {
    logger.info('Device back online');
    this.metricsCollector.recordOnlineStatus(true);

    // Trigger any pending sync tasks
    if (this.config.sync.enabled) {
      this.syncManager.handleConnectionChange(true);
    }
  }

  /**
   * Handle offline event
   */
  private handleOffline(): void {
    logger.info('Device went offline');
    this.metricsCollector.recordOnlineStatus(false);

    // Notify clients about offline status
    this.sendToClients({ type: 'OFFLINE_STATUS', online: false });
  }

  /**
   * Handle service worker errors
   */
  private handleError(event: ErrorEvent): void {
    logger.error('Service Worker error', {
      message: event.message,
      filename: event.filename,
      lineno: event.lineno,
      colno: event.colno,
      error: event.error,
    });

    this.metricsCollector.recordError(event.error);
  }

  /**
   * Handle unhandled promise rejections
   */
  private handleUnhandledRejection(event: PromiseRejectionEvent): void {
    logger.error('Unhandled promise rejection', {
      reason: event.reason,
    });

    this.metricsCollector.recordError(event.reason);
  }

  /**
   * Serve offline fallback page
   */
  private async serveOfflineFallback(request: Request): Promise<Response> {
    const fallbackUrl = this.config.offline.fallbackRoute;

    try {
      const cache = await this.cacheManager.openCache('offline-fallback');
      const fallbackResponse = await cache.match(fallbackUrl);

      if (fallbackResponse) {
        logger.debug('Serving offline fallback', { url: fallbackUrl });
        return new Response(fallbackResponse.body, {
          status: 200,
          statusText: 'OK',
          headers: fallbackResponse.headers,
        });
      }
    } catch (error) {
      logger.warn('Failed to serve offline fallback', { error });
    }

    // Return basic offline response
    return new Response(
      'Offline - No internet connection available',
      {
        status: 503,
        statusText: 'Service Unavailable',
        headers: {
          'Content-Type': 'text/plain',
          'Cache-Control': 'no-cache',
        },
      }
    );
  }

  /**
   * Generate unique cache key for request
   */
  private generateCacheKey(request: Request): string {
    return `${request.method}:${request.url}`;
  }

  /**
   * Check if cached response is expired
   */
  private isExpired(response: Response, maxAge: number): boolean {
    if (!maxAge) return false;

    const cacheTimestamp = response.headers.get('cache-timestamp');
    if (!cacheTimestamp) return true;

    const cacheTime = parseInt(cacheTimestamp);
    return Date.now() - cacheTime > maxAge;
  }

  /**
   * Fetch with timeout
   */
  private async fetchWithTimeout(request: Request, timeout?: number): Promise<Response> {
    if (!timeout) {
      return fetch(request);
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeout);

    try {
      const response = await fetch(request, {
        signal: controller.signal
      });
      clearTimeout(timeoutId);
      return response;
    } catch (error) {
      clearTimeout(timeoutId);
      throw error;
    }
  }

  /**
   * Update cache for specific URL
   */
  private async updateCache(url: string): Promise<void> {
    try {
      const request = new Request(url);
      const response = await fetch(request);

      if (response.ok) {
        const config = getCacheConfigForUrl(url);
        if (config) {
          await this.cacheManager.put(request, response, config.name);
        }
      }
    } catch (error) {
      logger.warn('Cache update failed', { url, error });
    }
  }

  /**
   * Send message to all clients
   */
  private async sendToClients(message: any): Promise<void> {
    try {
      const clients = await self.clients.matchAll();

      await Promise.all(
        clients.map(client =>
          client.postMessage(message).catch(error => {
            logger.warn('Failed to send message to client', {
              clientId: client.id,
              error
            });
          })
        )
      );
    } catch (error) {
      logger.warn('Failed to send message to clients', { error });
    }
  }

  /**
   * Notify clients about service worker update
   */
  private async notifyClientsUpdate(): Promise<void> {
    await this.sendToClients({
      type: 'SW_UPDATED',
      version: this.config.version
    });
  }
}

// Initialize the service worker
const serviceWorker = new ServiceWorker();

// Export for testing
export default serviceWorker;