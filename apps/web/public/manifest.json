      "icons": [
        {
          "src": "/icons/shortcut-wishlist-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Build Progress",
      "short_name": "Builds",
      "description": "Track your current build progress",
      "url": "/builds",
      "icons": [
        {
          "src": "/icons/shortcut-builds-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
