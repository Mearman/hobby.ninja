  "name": {
    "ja": "Bトレインショーティー 伊豆箱根鉄道3000系　ラブライブ！サンシャイン!! ラッピング電車　HAPPY PARTY TRAIN 2",
    "en": "B Train Shorty Izu Hakone Railway 3000 Series Love Live! Sunshine!! Wrapping train HAPPY PARTY TRAIN 2"
  },
  "price": {
    "amount": 1870,
