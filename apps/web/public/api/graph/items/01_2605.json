  "name": {
    "ja": "バトルピカちんキット05バッジDJリミックスシューター",
    "en": "Battle Pikachin Kit05 Badge DJ Remix Shooter"
  },
  "price": {
    "amount": 4620,
    "currency": "JPY",
    "taxIncluded": true,
