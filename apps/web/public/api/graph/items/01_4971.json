  "name": {
    "ja": "ガンダムデカール ガンダムベース限定 HG 1/144 ユニバーサルセンチュリーエンブレムセット 1",
    "en": "Gundam Decal Gundam Base Limited HG 1/144 Universal Century Emblem Set 1"
  },
  "price": {
    "amount": 550,
