  "name": {
    "ja": "チョッパーロボ1号&2号(チョッパータンク&チョッパーウイング)",
    "en": "Chopper Robo No. 1 & No. 2 (Chopper Tank & Chopper Wing)"
  },
  "price": {
    "amount": 1760,
    "currency": "JPY",
    "taxIncluded": true,
    "taxRate": 10
