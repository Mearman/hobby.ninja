  "description": [
    {
      "ja": "アーケードゲーム「機動戦士ガンダム 戦場の絆」に登場する“ザクＩスナイパー”がHGUCシリーズにラインナップ！",
      "en": "“Zaku I Sniper” that appears in the arcade game “Mobile Suit Gundam Battlefield Bonds” is now available in the HGUC series!"
    },
    {
      "ja": "バックパックと専用武器のビーム・スナイパー・ライフルを繋ぐケーブルを再現。",
      "en": "Reproduce the cable that connects the backpack and the special weapon beam sniper rifle."
    },
    {
      "ja": "右ヒザの専用アーマーを展開すればゲーム中の狙撃ポーズを再現可能。",
      "en": "By deploying the special armor on the right knee, you can recreate the sniper pose from the game."
    },
    {
      "ja": "モノアイとスコープレンズはクリアーパーツでリアルに再現。",
      "en": "The mono eye and scope lens are realistically reproduced with clear parts."
    }
  ],
