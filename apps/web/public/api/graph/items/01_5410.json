  "name": {
    "ja": "チョッパーロボ3号&5号(チョッパーサブマリン&チョッパークレーン)",
    "en": "Chopper Robo No. 3 & No. 5 (Chopper Submarine & Chopper Crane)"
  },
  "price": {
    "amount": 1760,
    "currency": "JPY",
    "taxIncluded": true,
