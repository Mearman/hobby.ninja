  "name": {
    "ja": "30MM オプションパーツセット ARMORED CORE VI FIRES OF RUBICON WEAPON SET 06",
    "en": "30MM Option parts set ARMORED CORE VI FIRES OF RUBICON WEAPON SET 06"
  },
  "price": {
    "amount": 1650,
