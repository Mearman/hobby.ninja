  "name": {
    "ja": "HG 1/144 ガンダムベース福岡限定 シナンジュ Ver.GSF",
    "en": "HG 1/144 Gundam Base Fukuoka Limited Sinanju Ver.GSF"
  },
  "price": {
    "amount": 3520,
    "currency": "JPY",
    "taxIncluded": true,
    "taxRate": 10
