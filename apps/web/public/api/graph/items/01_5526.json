  "name": {
    "ja": "MG 1/100 ガンダムベース限定 ガンダムエクシア [クリアカラー]",
    "en": "MG 1/100 Gundam Base Limited Gundam Exia [Clear Color]"
  },
  "price": {
    "amount": 4840,
