  "name": {
    "ja": "MG 1/100 ガンダムベース限定 デスティニーガンダム (ハイネ専用機)",
    "en": "MG 1/100 Gundam Base Limited Destiny Gundam (Heine exclusive machine)"
  },
  "price": {
    "amount": 7590,
    "currency": "JPY",
    "taxIncluded": true,
    "taxRate": 10
  },
  "releaseDate": {
    "ja": "2024年07月27日 (土)",
    "year": 2024,
    "month": 7,
    "day": 27
  },
  "targetAge": 15,
  "scale": "1/100",
  "description": [
    {
      "ja": "全世界のガンプラファンにむけた、公式ガンプラ総合施設「ガンダムベース」の限定アイテム。",
      "en": "A limited edition item from the official Gunpla facility \"Gundam Base\" for Gunpla fans around the world."
    },
    {
      "ja": "「MG デスティニーガンダム」がハイネ専用機のカラーリングになって登場！",
      "en": "\"MG Destiny Gundam\" is now available in the coloring of Heine's exclusive machine!"
    },
    {
      "ja": "• ハイネ・ヴェステンフルスのパーソナルカラーをイメージした、オレンジの成形色を採用。",
      "en": "• Adopts orange molding color, inspired by Heine Westenfurth's personal color."
    },
    {
      "ja": "• アロンダイトビームソード、高エネルギー長射程ビーム砲、フラッシュエッジ2ビームブーメラン他、豊富な武装が付属！",
      "en": "• Comes with a wealth of armaments including the Arondite Beam Sword, High Energy Long Range Beam Cannon, Flash Edge 2 Beam Boomerang, and more!"
    },
    {
      "ja": "• 迫力のポージングを彩る豊富なエフェクトパーツと専用の台座が付属！",
      "en": "• Comes with a variety of effect parts and a special pedestal to color the powerful poses!"
    },
    {
      "ja": "• プラモデルオリジナルの水転写デカールが付属。",
      "en": "• Includes plastic model original water slide decal."
    },
    {
      "ja": "• ハイネ専用機カラーの光の翼も付属した豪華仕様！",
      "en": "• A luxurious specification that also includes wings of light in the color of Heine's special machine!"
    }
  ],
