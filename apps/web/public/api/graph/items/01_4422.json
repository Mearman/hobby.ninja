  "name": {
    "ja": "MG 1/100 ガンダムベース限定 ガンダムキュリオス[クリアカラー］",
    "en": "MG 1/100 Gundam Base Limited Gundam Curios [Clear Color]"
  },
  "price": {
    "amount": 5830,
    "currency": "JPY",
