  "name": {
    "ja": "30MM ARMORED CORE VI FIRES OF RUBICON ARQUEBUS ADD VE-40A オープンフェイス",
    "en": "30MM ARMORED CORE VI FIRES OF RUBICON ARQUEBUS ADD VE-40A Open Face"
  },
  "price": {
    "amount": 5280,
    "currency": "JPY",
    "taxIncluded": true,
