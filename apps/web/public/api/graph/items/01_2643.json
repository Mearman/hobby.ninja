  "name": {
    "ja": "SD 三国創傑伝 甘寧クロスボーンガンダム",
    "en": "SD Sangoku Soketsuden Ganning Crossbone Gundam"
  },
  "price": {
    "amount": 770,
    "currency": "JPY",
    "taxIncluded": true,
    "taxRate": 10
  },
  "releaseDate": {
    "ja": "2021年04月",
    "year": 0,
    "month": 0
  },
  "targetAge": 8,
  "description": [
    {
      "ja": "【2021年春、日本展開開始！！】",
      "en": "[Spring 2021, main rollout begins! ! ]"
    },
    {
      "ja": "■『三国志』をベースにしたSD ガンダムが装いも新たに登場！",
      "en": "■SD Gundam based on \"Romance of the Three Kingdoms\" now has a new look!"
    },
    {
      "ja": "■進化したプロポーションとパーツ分割へのこだわりにより、組み立てただけでSD史上最高峰の色分けを実現。",
      "en": "■With advanced proportions and attention to parts division, we have achieved the highest color separation in SD history using just the assembly."
    },
    {
      "ja": "■一新された頭身バランスと各所の関節構造により、躍動感あふれるポージングを再現！",
      "en": "■The all-new head and body balance and joint structure in various parts allow for dynamic poses!"
    },
    {
      "ja": "■背中のスラスターとフロントスカートを組み合わせることで、紅炎の射出ギミックを再現可能！",
      "en": "■By combining the thruster on the back and the front skirt, you can reproduce the crimson flame injection gimmick!"
    },
    {
      "ja": "■クロスボーンガンダムのスラスターは、炎と鎖を組み合わせたデザイン。",
      "en": "■Crossbone Gundam's thruster has a design that combines flame and chains."
    },
    {
      "ja": "■付属武器”斬派明星”の先端にも、スラスターを取り付け可能！",
      "en": "■You can also attach a thruster to the tip of the included weapon “Zanpa Myojo”!"
    }
  ],
  "accessories": [
    {
      "ja": "斬派明星（銃）×1",
      "en": "Zanpa Myojo (gun) x1"
    },
    {
      "ja": "紅炎（短剣）×2",
      "en": "Crimson flame (dagger) x2"
    },
