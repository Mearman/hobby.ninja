{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/webapp/spec",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "test-setup.ts"
  ],
  "exclude": [
    "src/**/*.e2e.test.ts",
    "src/**/*.e2e.test.tsx",
    "src/**/*.e2e.spec.ts",
    "src/**/*.e2e.spec.tsx"
  ]
}