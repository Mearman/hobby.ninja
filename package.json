{
	"name": "hobby-ninja",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Nx monorepo for hobby collection management",
	"scripts": {
		"build": "nx run hobby-ninja:build",
		"build:prod": "nx run hobby-ninja:build:prod",
		"copy-data": "tsx scripts/copy-database.ts",
		"dev": "pnpm --filter @hobby-ninja/webapp dev",
		"serve": "nx serve web",
		"start": "nx serve web",
		"next:build": "cd apps/next && pnpm run build",
		"next:dev": "cd apps/next && pnpm run dev",
		"next:serve": "pnpm nx serve next",
			"test": "nx run hobby-ninja:test",
		"test:affected": "nx run hobby-ninja:test-affected",
		"test:e2e": "nx run hobby-ninja:test:e2e",
		"test:e2e:affected": "nx affected -t test:e2e",
		"lint": "nx run hobby-ninja:lint",
		"lint:check": "nx run hobby-ninja:lint:check",
		"lint:affected": "nx run hobby-ninja:lint-affected",
		"typecheck": "nx run hobby-ninja:typecheck",
		"typecheck:affected": "nx run hobby-ninja:typecheck-affected",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky install || true",
		"clean": "nx reset && rm -rf dist coverage .nx/cache",
		"graph": "nx graph",
		"graph:file": "nx graph --file=deps-graph.json",
		"show:projects": "nx show projects",
		"show:web": "nx show project web --web",
		"deps": "nx show project web --json | jq '.implicitDependencies'",
		"syncpack": "syncpack list-mismatches && syncpack fix-mismatches",
		"syncpack:check": "nx run hobby-ninja:syncpack:check",
		"syncpack:fix": "nx run hobby-ninja:syncpack:fix",
		"syncpack:lint": "nx run hobby-ninja:syncpack:lint",
		"knip": "nx run hobby-ninja:knip",
		"knip:production": "nx run hobby-ninja:knip:production",
		"knip:fix": "nx run hobby-ninja:knip:fix",
		"validate": "nx run hobby-ninja:validate",
		"validate:affected": "nx run hobby-ninja:validate-affected",
		"validate:ci": "nx run-many -t lint typecheck test --parallel=1",
		"check": "nx run hobby-ninja:check"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"pnpm": {
		"overrides": {
			"@tabler/icons": "3.27.0",
			"react": "19.2.1",
			"react-dom": "19.2.1",
			"@types/react": "19.2.7",
			"@types/react-dom": "19.2.3"
		}
	},
	"devDependencies": {
		"@mantine/modals": "8.3.9",
		"@nx/eslint": "22.1.3",
		"@nx/eslint-plugin": "22.1.3",
		"@nx/js": "22.1.3",
		"@nx/next": "^22.1.3",
		"@nx/playwright": "22.1.3",
		"@nx/react": "22.1.3",
		"@nx/vite": "22.1.3",
		"@playwright/test": "1.57.0",
		"@swc/helpers": "0.5.17",
		"@testing-library/react": "16.3.0",
		"@types/node": "*",
		"@types/pako": "^2.0.4",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "8.48.1",
		"@typescript-eslint/parser": "8.48.1",
		"@vitejs/plugin-react": "5.1.1",
		"@vitejs/plugin-react-swc": "4.2.2",
		"@vitest/ui": "4.0.15",
		"eslint": "*",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-barrel-files": "^3.0.1",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-markdown": "^5.1.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"eslint-plugin-sonarjs": "^3.0.5",
		"eslint-plugin-unicorn": "^62.0.0",
		"husky": "9.1.7",
		"knip": "^5.71.0",
		"lint-staged": "16.2.7",
		"nx": "22.1.3",
		"prettier": "3.7.4",
		"rollup-plugin-visualizer": "^6.0.5",
		"syncpack": "13.0.4",
		"tiktoken": "^1.0.22",
		"typescript": "*",
		"typescript-eslint": "^8.48.1",
		"vite": "*",
		"vite-plugin-pwa": "^1.2.0",
		"vitest": "*"
	},
	"dependencies": {
		"@mantine/core": "8.3.9",
		"@mantine/hooks": "8.3.9",
		"@mantine/notifications": "8.3.9",
		"@tabler/icons-react": "3.35.0",
		"@tanstack/react-router": "1.139.14",
		"@vanilla-extract/css": "1.17.5",
		"@vanilla-extract/dynamic": "2.1.5",
		"@vanilla-extract/vite-plugin": "5.1.3",
		"clsx": "2.1.1",
		"dexie": "4.2.1",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"zod": "4.2.0-canary.20251202T062120"
	},
	"packageManager": "pnpm@10.0.0"
}
