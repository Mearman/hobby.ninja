{
  "name": "unnamed-gunpla-app",
  "version": "0.0.1",
  "private": true,
  "description": "Nx monorepo for Gundam/Gunpla web application",
  "scripts": {
    "barrels": "barrelsby --config .barrelsby.json",
    "barrels:watch": "barrelsby --config .barrelsby.json --watch",
    "prebuild": "pnpm barrels",
    "build": "nx run unnamed-gunpla-app:build",
    "build:prod": "nx run unnamed-gunpla-app:build:prod",
    "dev": "pnpm --filter @unnamed-gunpla-app/webapp dev",
    "serve": "nx serve web",
    "start": "nx serve web",
    "test": "nx run unnamed-gunpla-app:test",
    "test:affected": "nx run unnamed-gunpla-app:test-affected",
    "test:e2e": "nx run unnamed-gunpla-app:test:e2e",
    "test:e2e:affected": "nx affected -t test:e2e",
    "lint": "nx run unnamed-gunpla-app:lint",
    "lint:check": "nx run unnamed-gunpla-app:lint:check",
    "lint:affected": "nx run unnamed-gunpla-app:lint-affected",
    "typecheck": "nx run unnamed-gunpla-app:typecheck",
    "typecheck:affected": "nx run unnamed-gunpla-app:typecheck-affected",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install || true",
    "clean": "nx reset && rm -rf dist coverage .nx/cache",
    "graph": "nx graph",
    "graph:file": "nx graph --file=deps-graph.json",
    "show:projects": "nx show projects",
    "show:web": "nx show project web --web",
    "deps": "nx show project web --json | jq '.implicitDependencies'",
    "syncpack": "syncpack list-mismatches && syncpack fix-mismatches",
    "syncpack:check": "nx run unnamed-gunpla-app:syncpack:check",
    "syncpack:fix": "nx run unnamed-gunpla-app:syncpack:fix",
    "syncpack:lint": "nx run unnamed-gunpla-app:syncpack:lint",
    "knip": "nx run unnamed-gunpla-app:knip",
    "knip:production": "nx run unnamed-gunpla-app:knip:production",
    "knip:fix": "nx run unnamed-gunpla-app:knip:fix",
    "validate": "nx run unnamed-gunpla-app:validate",
    "validate:affected": "nx run unnamed-gunpla-app:validate-affected",
    "validate:ci": "nx run-many -t lint typecheck test --parallel=1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@tabler/icons": "3.27.0"
    }
  },
  "devDependencies": {
    "@mantine/modals": "8.3.9",
    "@nx/eslint": "22.1.3",
    "@nx/eslint-plugin": "22.1.3",
    "@nx/js": "22.1.3",
    "@nx/playwright": "22.1.3",
    "@nx/react": "22.1.3",
    "@nx/vite": "22.1.3",
    "@playwright/test": "1.57.0",
    "@swc/helpers": "0.5.17",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "@vitejs/plugin-react": "5.1.1",
    "@vitejs/plugin-react-swc": "4.2.2",
    "@vitest/ui": "4.0.15",
    "barrelsby": "^2.8.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "9.1.7",
    "knip": "^5.71.0",
    "lint-staged": "16.2.7",
    "nx": "22.1.3",
    "prettier": "3.7.4",
    "rollup-plugin-visualizer": "^6.0.5",
    "syncpack": "13.0.4",
    "tiktoken": "^1.0.22",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "4.0.15"
  },
  "dependencies": {
    "@mantine/core": "8.3.9",
    "@mantine/hooks": "8.3.9",
    "@mantine/notifications": "8.3.9",
    "@tabler/icons-react": "3.35.0",
    "@tanstack/react-router": "1.139.14",
    "@vanilla-extract/css": "1.17.5",
    "@vanilla-extract/dynamic": "2.1.5",
    "@vanilla-extract/vite-plugin": "5.1.3",
    "clsx": "2.1.1",
    "dexie": "4.2.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.1.13"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}