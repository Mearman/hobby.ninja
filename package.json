{
	"name": "hobby-ninja",
	"description": "Nx monorepo for hobby collection management",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@10.0.0",
	"workspaces": [
		"apps/*",
		"packages/*",
		"data"
	],
	"scripts": {
		"build": "nx run hobby-ninja:build",
		"build:prod": "nx run hobby-ninja:build:prod",
		"check": "nx run hobby-ninja:check",
		"clean": "nx reset && rm -rf dist coverage .nx/cache",
		"clean-images": "npx tsx tools/image-cleaner.ts apps/next/public/images/items",
		"clean-images:remove": "npx tsx tools/image-cleaner.ts apps/next/public/images/items --remove",
		"copy-data": "tsx scripts/copy-database.ts",
		"deps": "nx show project web --json | jq '.implicitDependencies'",
		"dev": "pnpm --filter @hobby-ninja/webapp dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"graph": "nx graph",
		"graph:file": "nx graph --file=deps-graph.json",
		"knip": "nx run hobby-ninja:knip",
		"knip:fix": "nx run hobby-ninja:knip:fix",
		"knip:production": "nx run hobby-ninja:knip:production",
		"lint": "nx run hobby-ninja:lint",
		"lint:affected": "nx run hobby-ninja:lint-affected",
		"lint:check": "nx run hobby-ninja:lint:check",
		"next:build": "pnpm nx run next:build",
		"next:dev": "pnpm nx run next:dev",
		"next:serve": "pnpm nx run next:serve",
		"prepare": "husky install || true",
		"serve": "nx serve web",
		"show:projects": "nx show projects",
		"show:web": "nx show project web --web",
		"start": "nx serve web",
		"syncpack": "syncpack list-mismatches && syncpack fix-mismatches",
		"syncpack:check": "nx run hobby-ninja:syncpack:check",
		"syncpack:fix": "nx run hobby-ninja:syncpack:fix && pnpm install",
		"syncpack:lint": "nx run hobby-ninja:syncpack:lint",
		"update": "pnpm update --latest --recursive",
		"test": "nx run hobby-ninja:test",
		"test:affected": "nx run hobby-ninja:test-affected",
		"test:e2e": "nx run hobby-ninja:test:e2e",
		"test:e2e:affected": "nx affected -t test:e2e",
		"typecheck": "nx run hobby-ninja:typecheck",
		"typecheck:affected": "nx run hobby-ninja:typecheck-affected",
		"validate": "nx run hobby-ninja:validate",
		"validate:affected": "nx run hobby-ninja:validate-affected",
		"validate:ci": "nx run-many -t lint typecheck test --parallel=1"
	},
	"dependencies": {
		"@mantine/core": "8.3.10",
		"@mantine/hooks": "8.3.10",
		"@mantine/notifications": "8.3.10",
		"@tabler/icons-react": "3.35.0",
		"@tanstack/react-router": "1.140.0",
		"@vanilla-extract/css": "1.17.5",
		"@vanilla-extract/dynamic": "2.1.5",
		"@vanilla-extract/vite-plugin": "5.1.3",
		"clsx": "2.1.1",
		"dexie": "4.2.1",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"zod": "4.1.13"
	},
	"devDependencies": {
		"@mantine/modals": "8.3.10",
		"@nx/eslint": "22.2.0",
		"@nx/eslint-plugin": "22.2.0",
		"@nx/js": "22.2.0",
		"@nx/next": "22.2.0",
		"@nx/playwright": "22.2.0",
		"@nx/react": "22.2.0",
		"@nx/vite": "22.2.0",
		"@playwright/test": "1.57.0",
		"@swc/helpers": "0.5.17",
		"@testing-library/react": "16.3.0",
		"@types/node": "24.10.2",
		"@types/pako": "2.0.4",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@typescript-eslint/eslint-plugin": "8.49.0",
		"@typescript-eslint/parser": "8.49.0",
		"@vitejs/plugin-react": "5.1.2",
		"@vitejs/plugin-react-swc": "4.2.2",
		"@vitest/ui": "4.0.15",
		"concurrently": "^9.2.1",
		"eslint": "9.39.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-barrel-files": "3.0.1",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsonc": "^2.21.0",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-markdown": "5.1.0",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"eslint-plugin-sonarjs": "3.0.5",
		"eslint-plugin-unicorn": "62.0.0",
		"husky": "9.1.7",
		"jsonc-eslint-parser": "^2.4.2",
		"knip": "5.72.0",
		"lint-staged": "16.2.7",
		"nx": "22.2.0",
		"prettier": "3.7.4",
		"rollup-plugin-visualizer": "6.0.5",
		"syncpack": "13.0.4",
		"tiktoken": "1.0.22",
		"typescript": "5.9.3",
		"typescript-eslint": "8.49.0",
		"vite": "7.2.7",
		"vite-plugin-pwa": "1.2.0",
		"vitest": "4.0.15"
	},
	"pnpm": {
		"overrides": {
			"@tabler/icons": "3.27.0",
			"react": "19.2.1",
			"react-dom": "19.2.1",
			"@types/react": "19.2.7",
			"@types/react-dom": "19.2.3"
		}
	}
}
