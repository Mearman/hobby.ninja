{
  "name": "unnamed-gunpla-app",
  "version": "0.0.1",
  "private": true,
  "description": "Nx monorepo for Gundam/Gunpla web application",
  "scripts": {
    "barrels": "barrelsby --config .barrelsby.json",
    "barrels:watch": "barrelsby --config .barrelsby.json --watch",
    "prebuild": "pnpm barrels",
    "build": "nx run-many --target=build --all",
    "serve": "nx serve web",
    "start": "nx serve web",
    "test": "nx run-many --target=test --all",
    "test:unit": "nx run-many --target=test --all --exclude=e2e",
    "test:e2e": "nx run-many --target=e2e --all",
    "lint": "nx run-many --target=lint --all --fix",
    "lint:check": "nx run-many --target=lint --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install || true",
    "workspace:graph": "nx graph",
    "workspace:clean": "nx reset",
    "syncpack": "syncpack list-mismatches && syncpack fix-mismatches",
    "syncpack:check": "syncpack list-mismatches",
    "security": "node tools/security/src/index.ts",
    "security:scan": "node tools/security/src/index.ts scan",
    "security:deps": "node tools/security/src/index.ts dependencies",
    "security:sast": "node tools/security/src/index.ts sast",
    "security:iac": "node tools/security/src/index.ts infrastructure",
    "security:code": "node tools/security/src/index.ts code-quality",
    "security:auth": "node tools/security/src/index.ts authentication",
    "security:data": "node tools/security/src/index.ts data-protection",
    "security:xss": "node tools/security/src/index.ts xss-protection",
    "security:full": "node tools/security/src/index.ts full-scan",
    "security:report": "node tools/security/src/index.ts generate-report",
    "security:monitor": "node tools/security/src/index.ts continuous-monitoring",
    "security:ci": "yarn security:full --output ./security-reports"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@tabler/icons": "3.27.0"
    }
  },
  "devDependencies": {
    "@mantine/modals": "7.16.3",
    "@nx/eslint": "22.1.3",
    "@nx/eslint-plugin": "22.1.3",
    "@nx/js": "22.1.3",
    "@nx/playwright": "22.1.3",
    "@nx/react": "22.1.3",
    "@nx/vite": "22.1.3",
    "@playwright/test": "1.50.0",
    "@swc/helpers": "0.5.15",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "8.18.2",
    "@typescript-eslint/parser": "8.18.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitejs/plugin-react-swc": "3.7.2",
    "@vitest/ui": "2.1.8",
    "barrelsby": "^2.8.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "nx": "22.1.3",
    "prettier": "3.4.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "syncpack": "13.0.4",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "@mantine/core": "7.16.3",
    "@mantine/hooks": "7.16.3",
    "@mantine/notifications": "7.16.3",
    "@tabler/icons-react": "3.27.0",
    "@tanstack/react-router": "1.139.14",
    "@vanilla-extract/css": "1.17.0",
    "@vanilla-extract/dynamic": "2.1.2",
    "@vanilla-extract/vite-plugin": "5.1.3",
    "clsx": "2.1.1",
    "dexie": "4.0.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0"
}