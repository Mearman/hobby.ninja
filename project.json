{
  "name": "hobby-ninja",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".",
  "projectType": "application",
  "tags": ["scope:root", "type:workspace"],
  "targets": {
    "typecheck": {
      "dependsOn": ["types:typecheck", "utils:typecheck", "cli:typecheck", "scripts:typecheck", "web:typecheck"],
      "cache": true
    },
    "typecheck-root": {
      "executor": "@nx/js:tsc",
      "options": {
        "tsConfigPath": "./tsconfig.json",
        "noEmit": true,
        "main": "tools/scripts/index.ts",
        "outputPath": "dist/root"
      },
      "inputs": [
        "default",
        "{projectRoot}/*.config.ts"
      ],
      "cache": true,
      "metadata": {
        "description": "TypeScript type checking for root configuration files",
        "technologies": ["typescript"]
      }
    },
    "typecheck-affected": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx affected -t typecheck --parallel=5"
      },
      "cache": true
    },
    "build": {
      "dependsOn": ["types:build", "utils:build", "cli:build", "web:build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist"]
    },
    "build:prod": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many -t build --configuration=production"
      },
      "cache": true,
      "outputs": ["{workspaceRoot}/dist"]
    },
    "build-affected": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx affected -t build --parallel=3"
      },
      "cache": true,
      "outputs": ["{workspaceRoot}/dist"]
    },
    "test": {
      "dependsOn": ["types:test", "utils:test", "cli:test", "web:test"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["web:test:e2e"],
      "cache": true
    },
    "test-affected": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx affected -t test --parallel=3"
      },
      "cache": true
    },
    "lint": {
      "dependsOn": ["types:lint", "utils:lint", "cli:lint", "web:lint"],
      "cache": true
    },
    "lint:check": {
      "dependsOn": ["types:lint", "utils:lint", "cli:lint", "web:lint"],
      "cache": true
    },
    "lint-affected": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx affected -t lint --parallel=5"
      },
      "cache": true
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many -t lint typecheck test --parallel=1"
      },
      "cache": true,
      "dependsOn": ["types:build", "utils:build", "cli:build"]
    },
    "validate-affected": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx affected -t lint typecheck test --parallel=1"
      },
      "cache": true
    },
    "knip": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --no-exit-code"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/knip.config.ts",
        "{projectRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}"
      ]
    },
    "knip:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --no-exit-code --production"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/knip.config.ts",
        "{projectRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}"
      ]
    },
    "knip:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "knip --fix"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/knip.config.ts",
        "{projectRoot}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}"
      ]
    },
    "syncpack:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "syncpack list-mismatches"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/syncpack.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/packages/*/package.json"
      ]
    },
    "syncpack:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "syncpack lint-mismatches"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/syncpack.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/packages/*/package.json"
      ]
    },
    "syncpack:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "syncpack fix-mismatches"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/syncpack.config.ts",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/packages/*/package.json"
      ]
    }
  }
}