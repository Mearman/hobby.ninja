{
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(.specify/scripts/bash/check-prerequisites.sh:*)",
      "Bash(rm:*)",
      "Bash(echo:*)",
      "WebSearch",
      "Bash(cat:*)",
      "Bash(nx:*)",
      "Bash(git rm:*)"
